# Variables externalizadas de docker-compose.yml para las corridas de calibración
# de monitor-accesos-indebidos (ver su README.md para el detalle de cada umbral).
# Cambiar un valor aquí y correr:
#   docker compose up -d --no-deps monitor-accesos-indebidos
# aplica el nuevo umbral sin reconstruir ninguna imagen.

UMBRAL_VOLUMEN=8
UMBRAL_DIVERSIDAD=8
VENTANA_SEGUNDOS=30
